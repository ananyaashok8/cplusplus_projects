 255:.\source\rte/sc_joystick.h **** /**
 256:.\source\rte/sc_joystick.h ****  * Returns the current application value of the passed signal instance.
 257:.\source\rte/sc_joystick.h ****  *
 258:.\source\rte/sc_joystick.h ****  * @param  SC_JOYSTICK_t * const signal: Pointer to the signal object
 259:.\source\rte/sc_joystick.h ****  * @return sc_joystick_data_t: current value of the application data buffer
 260:.\source\rte/sc_joystick.h ****  *
 261:.\source\rte/sc_joystick.h ****  **/
 262:.\source\rte/sc_joystick.h **** inline SC_JOYSTICK_data_t RTE_SC_JOYSTICK_get( const SC_JOYSTICK_t * const signal )
 263:.\source\rte/sc_joystick.h **** {               
 264:.\source\rte/sc_joystick.h ****    //Todo: Critical region cannot be protected using return values																						
 265:.\source\rte/sc_joystick.h ****    return signal->value;                                                                           
 266:.\source\rte/sc_joystick.h **** }                                                                                                  
 267:.\source\rte/sc_joystick.h ****                                                                                                    
 268:.\source\rte/sc_joystick.h **** /**
 269:.\source\rte/sc_joystick.h ****  * Returns the current application value of the passed signal instance threadsafe.
 270:.\source\rte/sc_joystick.h ****  *
 271:.\source\rte/sc_joystick.h ****  * @param  SC_JOYSTICK_t * const signal: Pointer to the signal object
 272:.\source\rte/sc_joystick.h ****  * @param  SC_JOYSTICK_data_t* data: Pointer to the return data Pointer to the signal object
 273:.\source\rte/sc_joystick.h ****  * @return RC_SUCCESS
 274:.\source\rte/sc_joystick.h ****  *
 275:.\source\rte/sc_joystick.h ****  **/
 276:.\source\rte/sc_joystick.h **** inline RC_t RTE_SC_JOYSTICK_getThreadSafe( const SC_JOYSTICK_t * const signal, SC_JOYSTICK_data_t *
 277:.\source\rte/sc_joystick.h **** {    
 278:.\source\rte/sc_joystick.h ****    if (TRUE == signal->pSigCfg->resourceActive) GetResource(signal->pSigCfg->resource);
 279:.\source\rte/sc_joystick.h ****    *data = signal->value;
 280:.\source\rte/sc_joystick.h ****    if (TRUE == signal->pSigCfg->resourceActive) ReleaseResource(signal->pSigCfg->resource);        
 281:.\source\rte/sc_joystick.h **** 
 282:.\source\rte/sc_joystick.h ****    return RC_SUCCESS;                                                                   
 283:.\source\rte/sc_joystick.h ****    
 284:.\source\rte/sc_joystick.h **** }                                                                                                  
 285:.\source\rte/sc_joystick.h ****                                                                                                    
 286:.\source\rte/sc_joystick.h **** /**
 287:.\source\rte/sc_joystick.h ****  * Sets a new application value to the passed signal instance by passing the new value.
 288:.\source\rte/sc_joystick.h ****  * The corresponding driver raw value will be calculated immediately by using the default conversio
 289:.\source\rte/sc_joystick.h ****  * signal specific scaling function.
 290:.\source\rte/sc_joystick.h ****  * The signal age will be set to 0 and the new status will be 'RTE_SIGNALSTATUS_VALID'.
 291:.\source\rte/sc_joystick.h ****  *
 292:.\source\rte/sc_joystick.h ****  * @param  SC_JOYSTICK_t * const signal: Pointer to the signal object
 293:.\source\rte/sc_joystick.h ****  * @param  sc_joystick_data_t const value: value for the application data buffer
 294:.\source\rte/sc_joystick.h ****  * @return RC_t: standard return code, currently only RC_SUCCESS
 295:.\source\rte/sc_joystick.h ****  *
 296:.\source\rte/sc_joystick.h ****  **/
 297:.\source\rte/sc_joystick.h **** inline RC_t RTE_SC_JOYSTICK_set(SC_JOYSTICK_t * const signal, const SC_JOYSTICK_data_t value  )
 298:.\source\rte/sc_joystick.h **** {
 299:.\source\rte/sc_joystick.h **** 
 300:.\source\rte/sc_joystick.h ****    RC_t ret = RC_SUCCESS;
 301:.\source\rte/sc_joystick.h ****    size_t taskNum=0;
 302:.\source\rte/sc_joystick.h **** 
 303:.\source\rte/sc_joystick.h **** 
 304:.\source\rte/sc_joystick.h ****    if (TRUE == signal->pSigCfg->resourceActive) GetResource(signal->pSigCfg->resource);
 305:.\source\rte/sc_joystick.h ****    signal->value  = value;
