 307:.\source\rte/sc_joystick.h ****    signal->status = RTE_SIGNALSTATUS_VALID;
 308:.\source\rte/sc_joystick.h ****    if (TRUE == signal->pSigCfg->resourceActive) ReleaseResource(signal->pSigCfg->resource);
 309:.\source\rte/sc_joystick.h **** 
 310:.\source\rte/sc_joystick.h ****    //Pointer to the Taskarray, containing the tasks receiving the onUpdate events
 311:.\source\rte/sc_joystick.h ****    TaskTypeArray* pTaskArray = signal->pSigCfg->onUpdateTasks;
 312:.\source\rte/sc_joystick.h **** 
 313:.\source\rte/sc_joystick.h ****    if (NULL!=signal->pSigCfg->evOnUpdate && NULL != pTaskArray){
 314:.\source\rte/sc_joystick.h ****       for( taskNum=0 ; taskNum < signal->pSigCfg->onUpdateTaskCount ;taskNum++){
 315:.\source\rte/sc_joystick.h **** 		  
