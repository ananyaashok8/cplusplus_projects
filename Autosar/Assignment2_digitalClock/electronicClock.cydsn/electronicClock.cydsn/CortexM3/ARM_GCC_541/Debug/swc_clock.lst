 240:.\rte/sc_event.h ****  */
 241:.\rte/sc_event.h **** inline void RTE_SC_EVENT_incAge(  SC_EVENT_t * const signal , uint32_t increment)
 242:.\rte/sc_event.h **** {
 243:.\rte/sc_event.h **** 	   //Hack....
