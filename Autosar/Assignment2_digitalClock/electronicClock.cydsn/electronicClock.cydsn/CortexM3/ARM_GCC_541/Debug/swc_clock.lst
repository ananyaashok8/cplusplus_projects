 182:.\rte/sc_clock.h ****  * @param  SC_CLOCK_t * const signal: Pointer to the signal object
 183:.\rte/sc_clock.h ****  * @return  sig_status_t: The current signal status
 184:.\rte/sc_clock.h ****  *
 185:.\rte/sc_clock.h ****  **/
 186:.\rte/sc_clock.h **** inline RTE_signalStatus_t RTE_SC_CLOCK_getStatus( const SC_CLOCK_t * const signal )
 187:.\rte/sc_clock.h **** {
