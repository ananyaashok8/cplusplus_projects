 152:.\rte/sc_event.h **** /**
 153:.\rte/sc_event.h ****  * Initializes a signal instance with a passed init value.
 154:.\rte/sc_event.h ****  * Depending on the configured conversion or scaling function the raw_value will be calculated.
 155:.\rte/sc_event.h ****  * Signal status will change from RTE_SIGNALSTATUS_STARTUP to RTE_SIGNALSTATUS_INITIALIZED.
 156:.\rte/sc_event.h ****  *
 157:.\rte/sc_event.h ****  * @param  SC_EVENT_t * const signal: Pointer to the signal object which will be initialised
 158:.\rte/sc_event.h ****  * @param const sc_event_data_t * const value: Pointer to initial value of the application data
 159:.\rte/sc_event.h ****  * @return RC_t: standard return code, currently only RC_SUCCESS
 160:.\rte/sc_event.h ****  *
 161:.\rte/sc_event.h ****  **/
 162:.\rte/sc_event.h **** inline RC_t RTE_SC_EVENT_init( SC_EVENT_t * const signal, const SC_EVENT_data_t * const value )
 163:.\rte/sc_event.h **** {                                                                                                  
 164:.\rte/sc_event.h **** 
 165:.\rte/sc_event.h ****    RC_t ret = RC_SUCCESS;
 166:.\rte/sc_event.h **** 
 167:.\rte/sc_event.h ****    //Set value and raw value
 168:.\rte/sc_event.h ****    signal->value  = *value;
 169:.\rte/sc_event.h ****    signal->age    = 0;
 170:.\rte/sc_event.h ****    signal->status = RTE_SIGNALSTATUS_INITIALIZED;
 171:.\rte/sc_event.h **** 
 172:.\rte/sc_event.h ****    return ret;
 173:.\rte/sc_event.h **** }
 174:.\rte/sc_event.h **** 
 175:.\rte/sc_event.h **** /**************************************************************************************************
 176:.\rte/sc_event.h **** /* Status and timeout control																						*/
 177:.\rte/sc_event.h **** /**************************************************************************************************
 178:.\rte/sc_event.h **** 
 179:.\rte/sc_event.h **** /**
 180:.\rte/sc_event.h ****  *  Returns the current signal status of the passed signal instance.
 181:.\rte/sc_event.h ****  *
 182:.\rte/sc_event.h ****  * @param  SC_EVENT_t * const signal: Pointer to the signal object
 183:.\rte/sc_event.h ****  * @return  sig_status_t: The current signal status
 184:.\rte/sc_event.h ****  *
 185:.\rte/sc_event.h ****  **/
 186:.\rte/sc_event.h **** inline RTE_signalStatus_t RTE_SC_EVENT_getStatus( const SC_EVENT_t * const signal )
 187:.\rte/sc_event.h **** {
 188:.\rte/sc_event.h ****    return signal->status;
 189:.\rte/sc_event.h **** }
 190:.\rte/sc_event.h **** 
 191:.\rte/sc_event.h **** 
 192:.\rte/sc_event.h **** /**
 193:.\rte/sc_event.h ****  *  Sets a new signal status of the passed signal instance by passing the new status.
 194:.\rte/sc_event.h ****  *
 195:.\rte/sc_event.h ****  * @param  SC_EVENT_t * const signal: Pointer to the signal object
 196:.\rte/sc_event.h ****  * @param  const sig_status_t status: New signal status
 197:.\rte/sc_event.h ****  * @return RC_t: standard return code, currently only RC_SUCCESS
 198:.\rte/sc_event.h ****  *
 199:.\rte/sc_event.h ****  */
 200:.\rte/sc_event.h **** inline RC_t RTE_SC_EVENT_setStatus( SC_EVENT_t * const signal, const RTE_signalStatus_t status )
 201:.\rte/sc_event.h **** {
 202:.\rte/sc_event.h ****    signal->status = status;
 203:.\rte/sc_event.h ****    size_t taskNum=0;
 204:.\rte/sc_event.h ****    
 205:.\rte/sc_event.h ****    //Fire error events in case of invalid state
 206:.\rte/sc_event.h ****    if (signal->status == RTE_SIGNALSTATUS_INVALID)
 207:.\rte/sc_event.h ****    {
 208:.\rte/sc_event.h **** 	    //Pointer to the Taskarray, containing the tasks receiving the onUpdate events
ARM GAS  C:\Users\91819\AppData\Local\Temp\ccZyeurY.s 			page 30


 209:.\rte/sc_event.h **** 		TaskTypeArray* pTaskArray = signal->pSigCfg->onErrorTasks;
 210:.\rte/sc_event.h **** 
 211:.\rte/sc_event.h **** 		if (NULL!=signal->pSigCfg->evOnError && NULL != pTaskArray){
 212:.\rte/sc_event.h **** 			for( taskNum=0 ; taskNum < signal->pSigCfg->onErrorTaskCount ;taskNum++){
 213:.\rte/sc_event.h **** 				TaskType task = (*pTaskArray)[taskNum];
 214:.\rte/sc_event.h **** 				SetEvent( task, signal->pSigCfg->evOnError);
 215:.\rte/sc_event.h **** 			}
 216:.\rte/sc_event.h **** 		}
 217:.\rte/sc_event.h ****    }
 218:.\rte/sc_event.h ****    
 219:.\rte/sc_event.h ****    return RC_SUCCESS;
 220:.\rte/sc_event.h **** }
 221:.\rte/sc_event.h **** 
