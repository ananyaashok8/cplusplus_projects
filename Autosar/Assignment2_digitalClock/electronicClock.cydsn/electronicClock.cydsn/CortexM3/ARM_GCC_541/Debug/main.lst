 189:.\rte/sc_event.h **** }
 190:.\rte/sc_event.h **** 
 191:.\rte/sc_event.h **** 
 192:.\rte/sc_event.h **** /**
 193:.\rte/sc_event.h ****  *  Sets a new signal status of the passed signal instance by passing the new status.
 194:.\rte/sc_event.h ****  *
 195:.\rte/sc_event.h ****  * @param  SC_EVENT_t * const signal: Pointer to the signal object
 196:.\rte/sc_event.h ****  * @param  const sig_status_t status: New signal status
 197:.\rte/sc_event.h ****  * @return RC_t: standard return code, currently only RC_SUCCESS
 198:.\rte/sc_event.h ****  *
 199:.\rte/sc_event.h ****  */
 200:.\rte/sc_event.h **** inline RC_t RTE_SC_EVENT_setStatus( SC_EVENT_t * const signal, const RTE_signalStatus_t status )
 201:.\rte/sc_event.h **** {
 202:.\rte/sc_event.h ****    signal->status = status;
 203:.\rte/sc_event.h ****    size_t taskNum=0;
 204:.\rte/sc_event.h ****    
 205:.\rte/sc_event.h ****    //Fire error events in case of invalid state
 206:.\rte/sc_event.h ****    if (signal->status == RTE_SIGNALSTATUS_INVALID)
 207:.\rte/sc_event.h ****    {
 208:.\rte/sc_event.h **** 	    //Pointer to the Taskarray, containing the tasks receiving the onUpdate events
 209:.\rte/sc_event.h **** 		TaskTypeArray* pTaskArray = signal->pSigCfg->onErrorTasks;
 210:.\rte/sc_event.h **** 
 211:.\rte/sc_event.h **** 		if (NULL!=signal->pSigCfg->evOnError && NULL != pTaskArray){
 212:.\rte/sc_event.h **** 			for( taskNum=0 ; taskNum < signal->pSigCfg->onErrorTaskCount ;taskNum++){
 213:.\rte/sc_event.h **** 				TaskType task = (*pTaskArray)[taskNum];
 214:.\rte/sc_event.h **** 				SetEvent( task, signal->pSigCfg->evOnError);
 215:.\rte/sc_event.h **** 			}
 216:.\rte/sc_event.h **** 		}
 217:.\rte/sc_event.h ****    }
 218:.\rte/sc_event.h ****    
 219:.\rte/sc_event.h ****    return RC_SUCCESS;
 220:.\rte/sc_event.h **** }
